{
  "name": "docx-preview",
  "version": "0.3.6",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "word",
    "docx"
  ],
  "author": {
    "name": "Volodymyr Baydalka"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zVolodymyr/docxjs.git"
  },
  "dependencies": {
    "jszip": ">=3.0.0",
    "tsup": "^8.5.0"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "diff": "^8.0.2",
    "jasmine-core": "^5.12.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-firefox-launcher": "^2.1.3",
    "karma-jasmine": "^5.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup",
    "ts": "tsc --project tsconfig.json --noEmit",
    "watch": "rollup --config rollup.config.mjs --watch",
    "e2e": "karma start karma.conf.cjs --single-run",
    "e2e-watch": "karma start karma.conf.cjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "main": "./dist/docx-preview.js",
  "module": "./dist/docx-preview.js",
  "types": "./dist/docx-preview.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/docx-preview.d.ts"
      },
      "import": "./dist/docx-preview.js"
    }
  }
}